{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil de funcionário, docente ou administrador do sistema escolar SGE-NG",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "nomeCompleto": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "maxLength": 150 },
        "numeroBI": { "type": "string", "maxLength": 50 },
        "telefone": { "type": "string", "maxLength": 50 },
        "cargo": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["AdminGeral", "DiretorGeral", "SubdiretorPedagogico", "SubdirectorAdministrativo", "SubdiretorAdministrativo", "CoordenadorPedagogico", "ChefeSecretaria", "Secretario", "SecretarioEscolar", "CoordenadorTurno", "CoordenadorDisciplina", "Professor", "Secretaria", "Tesoureiro", "Bibliotecario", "Estagiario", "TecnicoTI", "AuxiliarLimpeza", "Encarregado"] },
        "escolaId": { "type": "string", "maxLength": 128 },
        "password": { "type": "string", "maxLength": 500 },
        "ativo": { "type": "boolean" },
        "statusConta": { "type": "string", "enum": ["Ativa", "Suspensa"] },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "nomeCompleto", "email", "role"]
    },
    "School": {
      "title": "School",
      "description": "Instituição de ensino cadastrada na rede",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "nomeOficial": { "type": "string", "maxLength": 250 },
        "codigoEscola": { "type": "string", "maxLength": 50 },
        "provincia": { "type": "string", "maxLength": 100 },
        "municipio": { "type": "string", "maxLength": 100 },
        "ativo": { "type": "boolean" },
        "anoLectivoActivo": { "type": "string", "maxLength": 50 },
        "recibosMatriculaPorFolhaA4": { "type": "number" },
        "recibosEmolumentosPorFolhaA4": { "type": "number" }
      },
      "required": ["id", "nomeOficial"]
    },
    "Student": {
      "title": "Student",
      "description": "Estudante matriculado na instituição escolar",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "codigoMatricula": { "type": "string", "maxLength": 100 },
        "nomeCompleto": { "type": "string", "maxLength": 200 },
        "escolaId": { "type": "string", "maxLength": 128 },
        "turmaId": { "type": "string", "maxLength": 128 },
        "classeId": { "type": "string", "maxLength": 50 },
        "estado": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "nomeCompleto", "codigoMatricula"]
    },
    "SystemConfig": {
      "title": "SystemConfig",
      "description": "Configurações gerais do sistema e insígnia nacional",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50 },
        "insigniaNacionalUrl": { "type": "string", "maxLength": 500000 },
        "nomeSistema": { "type": "string", "maxLength": 150 },
        "ministerioNome": { "type": "string", "maxLength": 150 },
        "updatedAt": { "type": "string" }
      },
      "required": ["id"]
    },
    "Message": {
      "title": "Message",
      "description": "Mensagens internas, circulares e comunicados escolares",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "escolaId": { "type": "string", "maxLength": 128 },
        "remetenteId": { "type": "string", "maxLength": 128 },
        "remetenteNome": { "type": "string", "maxLength": 200 },
        "assunto": { "type": "string", "maxLength": 300 },
        "conteudo": { "type": "string" },
        "lida": { "type": "boolean" },
        "dataHora": { "type": "string" }
      },
      "required": ["id", "escolaId", "conteudo"]
    },
    "TechnicalSupport": {
      "title": "TechnicalSupport",
      "description": "Chamados e solicitações de apoio técnico emitidos pelas direções escolares ao Administrador Geral (DTI/MED)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "escolaId": { "type": "string", "maxLength": 128 },
        "nomeEscola": { "type": "string", "maxLength": 250 },
        "motivo": { "type": "string", "maxLength": 300 },
        "descricaoProblema": { "type": "string" },
        "urgencia": { "type": "string", "enum": ["Baixa", "Media", "Alta", "Critica"] },
        "status": { "type": "string", "enum": ["Pendente", "Em_Atendimento", "Concluido", "Recusado"] }
      },
      "required": ["id", "escolaId", "motivo"]
    },
    "LibraryAccess": {
      "title": "LibraryAccess",
      "description": "Registos de acesso à biblioteca e empréstimos validados por Código QR do passe estudantil",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "escolaId": { "type": "string", "maxLength": 128 },
        "alunoId": { "type": "string", "maxLength": 128 },
        "alunoNome": { "type": "string", "maxLength": 200 },
        "codigoMatricula": { "type": "string", "maxLength": 100 },
        "tipoAcesso": { "type": "string", "enum": ["Entrada_Biblioteca", "Consulta_Local", "Emprestimo_Livro", "Devolucao_Livro"] },
        "dataHora": { "type": "string" }
      },
      "required": ["id", "escolaId", "alunoId", "tipoAcesso"]
    },
    "EventReport": {
      "title": "EventReport",
      "description": "Relatórios institucionais de acontecimentos, reuniões, palestras, eventos, desenvolvimentos e ocorrências escolares",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "escolaId": { "type": "string", "maxLength": 128 },
        "anoLectivo": { "type": "string", "maxLength": 50 },
        "categoria": { "type": "string", "enum": ["Reuniao", "Palestra", "Evento", "Desenvolvimento", "Ocorrencia"] },
        "titulo": { "type": "string", "maxLength": 300 },
        "data": { "type": "string", "maxLength": 30 },
        "organizadorNome": { "type": "string", "maxLength": 200 },
        "resumoAcontecimentos": { "type": "string" },
        "nivelVisibilidade": { "type": "string", "enum": ["Publico_Escola", "Direcao", "Docente_Turma", "Rede_Nacional"] },
        "estado": { "type": "string", "enum": ["Rascunho", "Registado", "Homologado"] }
      },
      "required": ["id", "escolaId", "categoria", "titulo", "data", "resumoAcontecimentos"]
    },
    "AreaFormacao": {
      "title": "AreaFormacao",
      "description": "Áreas de formação académicas e técnicas criadas pela direção escolar",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "escolaId": { "type": "string", "maxLength": 128 },
        "nome": { "type": "string", "maxLength": 200 },
        "codigo": { "type": "string", "maxLength": 50 },
        "ciclo": { "type": "string", "maxLength": 100 },
        "nivelEnsino": { "type": "string", "maxLength": 50 },
        "ativo": { "type": "boolean" }
      },
      "required": ["id", "nome"]
    },
    "Curso": {
      "title": "Curso",
      "description": "Cursos e especialidades curriculares criados ou geridos pela escola",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "escolaId": { "type": "string", "maxLength": 128 },
        "nome": { "type": "string", "maxLength": 200 },
        "codigo": { "type": "string", "maxLength": 50 },
        "area": { "type": "string", "maxLength": 200 },
        "areaFormacaoId": { "type": "string", "maxLength": 128 },
        "duracao": { "type": "string", "maxLength": 50 },
        "nivelEnsino": { "type": "string", "maxLength": 50 },
        "ciclo": { "type": "string", "maxLength": 100 },
        "ativo": { "type": "boolean" }
      },
      "required": ["id", "nome", "area"]
    },
    "SalaAula": {
      "title": "SalaAula",
      "description": "Salas de aula, laboratórios e espaços letivos vinculados às turmas",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "escolaId": { "type": "string", "maxLength": 128 },
        "nome": { "type": "string", "maxLength": 150 },
        "codigo": { "type": "string", "maxLength": 50 },
        "capacidade": { "type": "number" },
        "tipo": { "type": "string", "maxLength": 80 },
        "bloco": { "type": "string", "maxLength": 80 },
        "ativo": { "type": "boolean" }
      },
      "required": ["id", "nome"]
    },
    "ClasseConfig": {
      "title": "ClasseConfig",
      "description": "Classes escolares configuradas da Iniciação à 13ª Classe",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "escolaId": { "type": "string", "maxLength": 128 },
        "nome": { "type": "string", "maxLength": 80 },
        "nivelEnsino": { "type": "string", "maxLength": 50 },
        "ciclo": { "type": "string", "maxLength": 100 },
        "regimeAvaliacao": { "type": "string", "maxLength": 100 },
        "ordem": { "type": "number" },
        "ativa": { "type": "boolean" }
      },
      "required": ["id", "nome"]
    },
    "LibraryBook": {
      "title": "LibraryBook",
      "description": "Manuais, livros didáticos e documentos PDF da biblioteca escolar sincronizados offline e na nuvem",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "escolaId": { "type": "string", "maxLength": 128 },
        "titulo": { "type": "string", "maxLength": 300 },
        "autor": { "type": "string", "maxLength": 200 },
        "categoria": { "type": "string", "maxLength": 100 },
        "classe": { "type": "string", "maxLength": 60 },
        "disciplina": { "type": "string", "maxLength": 120 },
        "arquivoNome": { "type": "string", "maxLength": 260 },
        "arquivoArmazenamentoId": { "type": "string", "maxLength": 128 },
        "arquivoChunksCount": { "type": "number" },
        "tipoRecurso": { "type": "string", "enum": ["PDF", "Link"] }
      },
      "required": ["id", "escolaId", "titulo"]
    },
    "CustomCoordinationType": {
      "title": "CustomCoordinationType",
      "description": "Tipos de coordenação personalizados adicionados pela Direção da escola",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "escolaId": { "type": "string", "maxLength": 128 },
        "nivelEnsino": { "type": "string", "enum": ["Primario", "ICiclo", "IICiclo"] },
        "tipo": { "type": "string", "maxLength": 160 },
        "descricao": { "type": "string", "maxLength": 600 },
        "requerClasse": { "type": "boolean" },
        "requerTurma": { "type": "boolean" },
        "requerDisciplina": { "type": "boolean" },
        "requerCurso": { "type": "boolean" },
        "requerTurno": { "type": "boolean" },
        "requerAreaDisciplinar": { "type": "boolean" },
        "ativo": { "type": "boolean" },
        "criadoEm": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "escolaId", "nivelEnsino", "tipo"]
    },
    "PedagogicalReport": {
      "title": "PedagogicalReport",
      "description": "Relatórios formais de final de ano de coordenação e relatórios docentes trimestrais ou anuais",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "escolaId": { "type": "string", "maxLength": 128 },
        "anoLectivo": { "type": "string", "maxLength": 32 },
        "tipoRelatorio": { "type": "string", "enum": ["COORDENACAO_FINAL_ANO", "DOCENTE_TRIMESTRAL_ANUAL"] },
        "periodoReferencia": { "type": "string", "enum": ["1", "2", "3", "Anual"] },
        "tituloDocumento": { "type": "string", "maxLength": 300 },
        "estado": { "type": "string", "enum": ["Rascunho", "Finalizado", "Homologado"] },
        "criadoPorId": { "type": "string", "maxLength": 128 },
        "criadoPorNome": { "type": "string", "maxLength": 200 },
        "criadoEm": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "escolaId", "anoLectivo", "tipoRelatorio", "periodoReferencia", "tituloDocumento"]
    },
    "ActivityPlanItem": {
      "title": "ActivityPlanItem",
      "description": "Atividades e eventos dos planos por área e perfil (Coordenadores, Secretaria, Subdiretores e Diretor Geral)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "escolaId": { "type": "string", "maxLength": 128 },
        "anoLectivo": { "type": "string", "maxLength": 32 },
        "trimestre": { "type": "string", "enum": ["1", "2", "3", "Anual"] },
        "titulo": { "type": "string", "maxLength": 300 },
        "descricao": { "type": "string" },
        "categoria": { "type": "string", "maxLength": 80 },
        "dataInicio": { "type": "string", "maxLength": 32 },
        "areaOrigem": { "type": "string", "enum": ["Direcao_Geral", "Subdirecao_Pedagogica", "Subdirecao_Administrativa", "Coordenacao_Pedagogica", "Secretaria_Geral"] },
        "perfilOrigemRole": { "type": "string", "maxLength": 80 },
        "criadoPorId": { "type": "string", "maxLength": 128 },
        "criadoPorNome": { "type": "string", "maxLength": 200 },
        "estadoExecucao": { "type": "string", "enum": ["Planeada", "Em_Curso", "Realizada", "Adiada", "Cancelada"] },
        "percentualCumprimento": { "type": "number" },
        "excluidaDoPlanoGeralPorDiretor": { "type": "boolean" }
      },
      "required": ["id", "escolaId", "anoLectivo", "trimestre", "titulo", "dataInicio", "areaOrigem", "estadoExecucao"]
    },
    "PersonalFinanceData": {
      "title": "PersonalFinanceData",
      "description": "Dados de finanças pessoais estritamente isolados por utilizador (receitas, despesas, orçamentos, metas de poupança e dívidas)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "transacoes": { "type": "array" },
        "orcamentosPorMes": { "type": "object" },
        "metasPoupanca": { "type": "array" },
        "dividas": { "type": "array" },
        "atualizadoEm": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId"]
    },
    "ExamScheduleItem": {
      "title": "ExamScheduleItem",
      "description": "Horários de provas, exames e provas de recurso por escola e ano letivo",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "escolaId": { "type": "string", "maxLength": 128 },
        "anoLectivo": { "type": "string", "maxLength": 32 },
        "tipoProva": { "type": "string", "maxLength": 80 },
        "classe": { "type": "string", "maxLength": 40 },
        "turmaId": { "type": "string", "maxLength": 128 },
        "disciplinaId": { "type": "string", "maxLength": 128 },
        "data": { "type": "string", "maxLength": 32 },
        "horaInicio": { "type": "string", "maxLength": 16 },
        "horaFim": { "type": "string", "maxLength": 16 }
      },
      "required": ["id", "escolaId", "anoLectivo", "turmaId", "disciplinaId", "data"]
    },
    "ExamSupervisionMap": {
      "title": "ExamSupervisionMap",
      "description": "Mapas de fiscalização de provas com 1 a 4 professores fiscalizadores por turma",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "escolaId": { "type": "string", "maxLength": 128 },
        "anoLectivo": { "type": "string", "maxLength": 32 },
        "horarioProvaId": { "type": "string", "maxLength": 128 },
        "turmaId": { "type": "string", "maxLength": 128 },
        "fiscais": { "type": "array" }
      },
      "required": ["id", "escolaId", "anoLectivo", "horarioProvaId", "fiscais"]
    },
    "ExamMinute": {
      "title": "ExamMinute",
      "description": "Atas de provas redigidas pelos professores fiscalizadores com registo de ocorrências",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "escolaId": { "type": "string", "maxLength": 128 },
        "anoLectivo": { "type": "string", "maxLength": 32 },
        "mapaFiscalizacaoId": { "type": "string", "maxLength": 128 },
        "horarioProvaId": { "type": "string", "maxLength": 128 },
        "estado": { "type": "string", "enum": ["Rascunho", "Finalizada"] }
      },
      "required": ["id", "escolaId", "anoLectivo", "mapaFiscalizacaoId", "estado"]
    },
    "VacationScheduleItem": {
      "title": "VacationScheduleItem",
      "description": "Registo de férias no Mapa de Férias dos funcionários administrativos e auxiliares de limpeza",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "escolaId": { "type": "string", "maxLength": 128 },
        "anoLectivo": { "type": "string", "maxLength": 32 },
        "funcionarioId": { "type": "string", "maxLength": 128 },
        "funcionarioNome": { "type": "string", "maxLength": 200 },
        "grupoCategoria": { "type": "string", "enum": ["Administrativo", "AuxiliarLimpeza"] },
        "dataInicio": { "type": "string", "maxLength": 32 },
        "dataFim": { "type": "string", "maxLength": 32 },
        "estado": { "type": "string", "enum": ["Planeada", "Aprovada", "Em_Curso", "Concluida", "Adiada", "Cancelada"] }
      },
      "required": ["id", "escolaId", "anoLectivo", "funcionarioId", "dataInicio", "dataFim"]
    },
    "CleaningMaterial": {
      "title": "CleaningMaterial",
      "description": "Material ou consumível cadastrado no estoque de limpeza escolar",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "escolaId": { "type": "string", "maxLength": 128 },
        "nome": { "type": "string", "maxLength": 200 },
        "categoria": { "type": "string", "maxLength": 120 },
        "unidade": { "type": "string", "maxLength": 60 },
        "quantidadeAtual": { "type": "number" },
        "quantidadeMinima": { "type": "number" }
      },
      "required": ["id", "escolaId", "nome", "quantidadeAtual"]
    },
    "CleaningStockMovement": {
      "title": "CleaningStockMovement",
      "description": "Movimento de entrada, saída ou ajuste no estoque de materiais de limpeza",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "escolaId": { "type": "string", "maxLength": 128 },
        "materialId": { "type": "string", "maxLength": 128 },
        "tipo": { "type": "string", "enum": ["Entrada", "Saida", "Ajuste"] },
        "quantidade": { "type": "number" },
        "data": { "type": "string", "maxLength": 32 },
        "responsavelId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "escolaId", "materialId", "tipo", "quantidade", "data"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Perfis dos utilizadores e funcionários do sistema SGE-NG"
    },
    "/schools/{schoolId}": {
      "schema": "School",
      "description": "Instituições escolares da rede nacional de Angola"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Registos e matrículas de alunos"
    },
    "/system_config/{configId}": {
      "schema": "SystemConfig",
      "description": "Configurações globais e insígnia oficial do sistema"
    },
    "/mensagens/{mensagemId}": {
      "schema": "Message",
      "description": "Mensagens e comunicados escolares sincronizados"
    },
    "/solicitacoes_apoio/{solId}": {
      "schema": "TechnicalSupport",
      "description": "Solicitações de apoio técnico e autorizações ministeriais"
    },
    "/biblioteca_acessos/{accessId}": {
      "schema": "LibraryAccess",
      "description": "Registos em tempo real de entrada e empréstimos na biblioteca por QR Code"
    },
    "/relatorios_acontecimentos/{reportId}": {
      "schema": "EventReport",
      "description": "Relatórios institucionais de acontecimentos, reuniões, palestras e desenvolvimentos"
    },
    "/areas_formacao/{areaId}": {
      "schema": "AreaFormacao",
      "description": "Áreas de formação académicas e técnicas configuradas pelas escolas"
    },
    "/cursos/{cursoId}": {
      "schema": "Curso",
      "description": "Cursos curriculares e especialidades geridos pela direção escolar"
    },
    "/salas_aulas/{salaId}": {
      "schema": "SalaAula",
      "description": "Salas de aulas e infraestruturas físicas associadas às turmas"
    },
    "/classes_configs/{classeId}": {
      "schema": "ClasseConfig",
      "description": "Configuração das classes escolares da Iniciação à 13ª Classe"
    },
    "/biblioteca/{bookId}": {
      "schema": "LibraryBook",
      "description": "Livros e manuais PDF da Biblioteca Escolar"
    },
    "/biblioteca_arquivos/{chunkId}": {
      "schema": "LibraryBook",
      "description": "Fragmentos binários em Base64 de PDFs da biblioteca para sincronização offline-first"
    },
    "/tipos_coordenacao/{tipoId}": {
      "schema": "CustomCoordinationType",
      "description": "Tipos de coordenação personalizados configurados pela Direção da escola"
    },
    "/relatorios_pedagogicos/{reportId}": {
      "schema": "PedagogicalReport",
      "description": "Relatórios formais editáveis de coordenação (final de ano) e docentes (trimestrais/anuais)"
    },
    "/planos_atividades/{atividadeId}": {
      "schema": "ActivityPlanItem",
      "description": "Atividades e eventos dos planos por área (Coordenadores, Secretaria, Subdiretores e Diretor Geral)"
    },
    "/financas_pessoais/{userId}": {
      "schema": "PersonalFinanceData",
      "description": "Finanças pessoais isoladas por utilizador"
    },
    "/horarios_provas/{horarioId}": {
      "schema": "ExamScheduleItem",
      "description": "Horários de provas, exames e recursos"
    },
    "/mapas_fiscalizacao/{mapaId}": {
      "schema": "ExamSupervisionMap",
      "description": "Mapas de fiscalização de provas (1 a 4 professores por turma)"
    },
    "/atas_provas/{ataId}": {
      "schema": "ExamMinute",
      "description": "Atas de provas com ocorrências e presenças"
    },
    "/mapas_ferias/{feriasId}": {
      "schema": "VacationScheduleItem",
      "description": "Mapa de férias de funcionários administrativos e auxiliares de limpeza"
    },
