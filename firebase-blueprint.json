{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil de funcionário, docente ou administrador do sistema escolar SGE-NG",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "nomeCompleto": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "maxLength": 150 },
        "numeroBI": { "type": "string", "maxLength": 50 },
        "telefone": { "type": "string", "maxLength": 50 },
        "cargo": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["AdminGeral", "DiretorGeral", "SubdiretorPedagogico", "SubdirectorAdministrativo", "SubdiretorAdministrativo", "Professor", "Secretaria", "Encarregado"] },
        "escolaId": { "type": "string", "maxLength": 128 },
        "password": { "type": "string", "maxLength": 500 },
        "ativo": { "type": "boolean" },
        "statusConta": { "type": "string", "enum": ["Ativa", "Suspensa"] },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "nomeCompleto", "email", "role"]
    },
    "School": {
      "title": "School",
      "description": "Instituição de ensino cadastrada na rede",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "nomeOficial": { "type": "string", "maxLength": 250 },
        "codigoEscola": { "type": "string", "maxLength": 50 },
        "provincia": { "type": "string", "maxLength": 100 },
        "municipio": { "type": "string", "maxLength": 100 },
        "ativo": { "type": "boolean" },
        "anoLectivoActivo": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "nomeOficial"]
    },
    "Student": {
      "title": "Student",
      "description": "Estudante matriculado na instituição escolar",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "codigoMatricula": { "type": "string", "maxLength": 100 },
        "nomeCompleto": { "type": "string", "maxLength": 200 },
        "escolaId": { "type": "string", "maxLength": 128 },
        "turmaId": { "type": "string", "maxLength": 128 },
        "classeId": { "type": "string", "maxLength": 50 },
        "estado": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "nomeCompleto", "codigoMatricula"]
    },
    "SystemConfig": {
      "title": "SystemConfig",
      "description": "Configurações gerais do sistema e insígnia nacional",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50 },
        "insigniaNacionalUrl": { "type": "string", "maxLength": 500000 },
        "nomeSistema": { "type": "string", "maxLength": 150 },
        "ministerioNome": { "type": "string", "maxLength": 150 },
        "updatedAt": { "type": "string" }
      },
      "required": ["id"]
    },
    "Message": {
      "title": "Message",
      "description": "Mensagens internas, circulares e comunicados escolares",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "escolaId": { "type": "string", "maxLength": 128 },
        "remetenteId": { "type": "string", "maxLength": 128 },
        "remetenteNome": { "type": "string", "maxLength": 200 },
        "assunto": { "type": "string", "maxLength": 300 },
        "conteudo": { "type": "string" },
        "lida": { "type": "boolean" },
        "dataHora": { "type": "string" }
      },
      "required": ["id", "escolaId", "conteudo"]
    },
    "TechnicalSupport": {
      "title": "TechnicalSupport",
      "description": "Chamados e solicitações de apoio técnico emitidos pelas direções escolares ao Administrador Geral (DTI/MED)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "escolaId": { "type": "string", "maxLength": 128 },
        "nomeEscola": { "type": "string", "maxLength": 250 },
        "motivo": { "type": "string", "maxLength": 300 },
        "descricaoProblema": { "type": "string" },
        "urgencia": { "type": "string", "enum": ["Baixa", "Media", "Alta", "Critica"] },
        "status": { "type": "string", "enum": ["Pendente", "Em_Atendimento", "Concluido", "Recusado"] }
      },
      "required": ["id", "escolaId", "motivo"]
    },
    "LibraryAccess": {
      "title": "LibraryAccess",
      "description": "Registos de acesso à biblioteca e empréstimos validados por Código QR do passe estudantil",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "escolaId": { "type": "string", "maxLength": 128 },
        "alunoId": { "type": "string", "maxLength": 128 },
        "alunoNome": { "type": "string", "maxLength": 200 },
        "codigoMatricula": { "type": "string", "maxLength": 100 },
        "tipoAcesso": { "type": "string", "enum": ["Entrada_Biblioteca", "Consulta_Local", "Emprestimo_Livro", "Devolucao_Livro"] },
        "dataHora": { "type": "string" }
      },
      "required": ["id", "escolaId", "alunoId", "tipoAcesso"]
    },
    "EventReport": {
      "title": "EventReport",
      "description": "Relatórios institucionais de acontecimentos, reuniões, palestras, eventos, desenvolvimentos e ocorrências escolares",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "escolaId": { "type": "string", "maxLength": 128 },
        "anoLectivo": { "type": "string", "maxLength": 50 },
        "categoria": { "type": "string", "enum": ["Reuniao", "Palestra", "Evento", "Desenvolvimento", "Ocorrencia"] },
        "titulo": { "type": "string", "maxLength": 300 },
        "data": { "type": "string", "maxLength": 30 },
        "organizadorNome": { "type": "string", "maxLength": 200 },
        "resumoAcontecimentos": { "type": "string" },
        "nivelVisibilidade": { "type": "string", "enum": ["Publico_Escola", "Direcao", "Docente_Turma", "Rede_Nacional"] },
        "estado": { "type": "string", "enum": ["Rascunho", "Registado", "Homologado"] }
      },
      "required": ["id", "escolaId", "categoria", "titulo", "data", "resumoAcontecimentos"]
    },
    "AreaFormacao": {
      "title": "AreaFormacao",
      "description": "Áreas de formação académicas e técnicas criadas pela direção escolar",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "escolaId": { "type": "string", "maxLength": 128 },
        "nome": { "type": "string", "maxLength": 200 },
        "codigo": { "type": "string", "maxLength": 50 },
        "ciclo": { "type": "string", "maxLength": 100 },
        "nivelEnsino": { "type": "string", "maxLength": 50 },
        "ativo": { "type": "boolean" }
      },
      "required": ["id", "nome"]
    },
    "Curso": {
      "title": "Curso",
      "description": "Cursos e especialidades curriculares criados ou geridos pela escola",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "escolaId": { "type": "string", "maxLength": 128 },
        "nome": { "type": "string", "maxLength": 200 },
        "codigo": { "type": "string", "maxLength": 50 },
        "area": { "type": "string", "maxLength": 200 },
        "areaFormacaoId": { "type": "string", "maxLength": 128 },
        "duracao": { "type": "string", "maxLength": 50 },
        "nivelEnsino": { "type": "string", "maxLength": 50 },
        "ciclo": { "type": "string", "maxLength": 100 },
        "ativo": { "type": "boolean" }
      },
      "required": ["id", "nome", "area"]
    },
    "SalaAula": {
      "title": "SalaAula",
      "description": "Salas de aula, laboratórios e espaços letivos vinculados às turmas",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "escolaId": { "type": "string", "maxLength": 128 },
        "nome": { "type": "string", "maxLength": 150 },
        "codigo": { "type": "string", "maxLength": 50 },
        "capacidade": { "type": "number" },
        "tipo": { "type": "string", "maxLength": 80 },
        "bloco": { "type": "string", "maxLength": 80 },
        "ativo": { "type": "boolean" }
      },
      "required": ["id", "nome"]
    },
    "ClasseConfig": {
      "title": "ClasseConfig",
      "description": "Classes escolares configuradas da Iniciação à 13ª Classe",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "escolaId": { "type": "string", "maxLength": 128 },
        "nome": { "type": "string", "maxLength": 80 },
        "nivelEnsino": { "type": "string", "maxLength": 50 },
        "ciclo": { "type": "string", "maxLength": 100 },
        "regimeAvaliacao": { "type": "string", "maxLength": 100 },
        "ordem": { "type": "number" },
        "ativa": { "type": "boolean" }
      },
      "required": ["id", "nome"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Perfis dos utilizadores e funcionários do sistema SGE-NG"
    },
    "/schools/{schoolId}": {
      "schema": "School",
      "description": "Instituições escolares da rede nacional de Angola"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Registos e matrículas de alunos"
    },
    "/system_config/{configId}": {
      "schema": "SystemConfig",
      "description": "Configurações globais e insígnia oficial do sistema"
    },
    "/mensagens/{mensagemId}": {
      "schema": "Message",
      "description": "Mensagens e comunicados escolares sincronizados"
    },
    "/solicitacoes_apoio/{solId}": {
      "schema": "TechnicalSupport",
      "description": "Solicitações de apoio técnico e autorizações ministeriais"
    },
    "/biblioteca_acessos/{accessId}": {
      "schema": "LibraryAccess",
      "description": "Registos em tempo real de entrada e empréstimos na biblioteca por QR Code"
    },
    "/relatorios_acontecimentos/{reportId}": {
      "schema": "EventReport",
      "description": "Relatórios institucionais de acontecimentos, reuniões, palestras e desenvolvimentos"
    },
    "/areas_formacao/{areaId}": {
      "schema": "AreaFormacao",
      "description": "Áreas de formação académicas e técnicas configuradas pelas escolas"
    },
    "/cursos/{cursoId}": {
      "schema": "Curso",
      "description": "Cursos curriculares e especialidades geridos pela direção escolar"
    },
    "/salas_aulas/{salaId}": {
      "schema": "SalaAula",
      "description": "Salas de aulas e infraestruturas físicas associadas às turmas"
    },
    "/classes_configs/{classeId}": {
      "schema": "ClasseConfig",
      "description": "Configuração das classes escolares da Iniciação à 13ª Classe"
    }
  }
}
