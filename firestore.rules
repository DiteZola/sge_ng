rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Coleção de Perfis de Utilizadores
    match /users/{userId} {
      allow read: if true; // Permite consulta de perfis de utilizador para verificação de credenciais e sincronização online/offline
      allow write: if true; // Permite guardar e atualizar perfis diretamente sincronizados com o dispositivo
    }

    // Coleção de Escolas
    match /schools/{schoolId} {
      allow read, write: if true;
    }

    // Coleção de Estudantes
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Configuração Geral do Sistema e Insígnia
    match /system_config/{configId} {
      allow read, write: if true;
    }

    // Coleção de Teste de Conexão
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
